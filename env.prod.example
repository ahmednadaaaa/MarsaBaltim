# =============================================================================
# BALTIM BACKEND - AWS PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to '.env' on your AWS EC2/Lightsail server.
# NEVER commit the actual '.env' containing secrets to GitHub/Git.

# --- Django Core Settings ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE
# Comma-separated list of allowed hostnames (e.g., api.baltim.com,baltim.com)
DJANGO_ALLOWED_HOSTS=marsabaltim.com,www.marsabaltim.com

# --- Database Configurations ---
DB_NAME=baltim_prod
DB_USER=baltim_admin
DB_PASSWORD=CHOOSE_A_STRONG_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

# --- AWS Amazon S3 Media Storage ---
AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY_HERE
AWS_STORAGE_BUCKET_NAME=marsabaltim-media-bucket-name
AWS_S3_REGION_NAME=us-east-1

# --- JWT & Cookie Security (HTTPS Mandatory) ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SIMPLE_JWT_COOKIE_SECURE=True

# --- Security Headers (HTTPS Only) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- CORS Settings ---
# Comma-separated allowed frontends (e.g., https://baltim.com,https://admin.baltim.com)
CORS_ALLOWED_ORIGINS=https://marsabaltim.com,https://www.marsabaltim.com

# --- SMTP / Email Configurations ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=marsabaltim@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=marsabaltim@gmail.com
