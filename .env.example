# -----------------------------------------------------------------------------
# BALTIM BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to '.env' in your deployment environment and customize values.
# NEVER commit the actual '.env' file containing real secrets to version control.

# --- Django Core Settings ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-string-here-for-production
# Comma-separated list of allowed hostnames (e.g. baltim.com,www.baltim.com,12.34.56.78)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Configurations ---
# If using a single connection URL (recommended on Heroku, Render, AWS ALBs):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Otherwise, define individual parameters:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=baltim
DB_USER=postgres
DB_PASSWORD=ahmed123
DB_HOST=localhost
DB_PORT=5432

# --- JWT & Cookie Security ---
# Ensure these are True when serving over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SIMPLE_JWT_COOKIE_SECURE=True

# --- Security Headers & Redirection (HTTPS Only) ---
SECURE_SSL_REDIRECT=True
# 1 year (31536000 seconds) for HTTP Strict Transport Security
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- CORS Settings ---
# Comma-separated allowed origins (e.g., https://baltim.com,https://admin.baltim.com)
CORS_ALLOWED_ORIGINS=https://localhost:3000

# --- SMTP / Email Configurations ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=marsabaltim@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-specific-password-here
DEFAULT_FROM_EMAIL=marsabaltim@gmail.com
